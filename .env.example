AUTH_SECRET=run-openssl-rand-base64-32
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
# TikTok Login Kit + Display API (clipper login & view tracking)
# developers.tiktok.com → your app → Login Kit; scopes: user.info.basic, video.list
# Redirect URI: https://<your-domain>/api/auth/callback/tiktok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Clipper Studio ─────────────────────────────────────────────
# Postgres (Railway → add Postgres → copy DATABASE_URL). Migrations run automatically on web `npm start` (or `npm run migrate`).
DATABASE_URL=postgresql://postgres@localhost:5433/clipfarm
# Cloudflare R2 (S3-compatible). Leave blank in dev to store files on local disk (.data/storage).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clipfarm-media
# Local-disk storage root when R2 isn't configured (web + worker must share it).
LOCAL_STORAGE_DIR=.data/storage
# Word-level captions (Whisper). Without it, "Auto captions" is disabled.
OPENAI_API_KEY=
# Worker tuning
WORKER_CONCURRENCY=1
# Max length a clipper can pull from a VOD in one import (seconds)
MAX_IMPORT_SECONDS=900
