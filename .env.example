AUTH_SECRET=run-openssl-rand-base64-32
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
# TikTok Login Kit + Display API (clipper login & view tracking)
# developers.tiktok.com → your app → add Login Kit + Content Posting API products.
# Scopes: user.info.basic, video.list (view tracking), video.upload (Studio → TikTok drafts).
# Redirect URI: https://<your-domain>/api/auth/callback/tiktok
# In Sandbox mode, add your own TikTok account as a target user or login will be rejected.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Override if your TikTok app doesn't have video.upload approved yet (drafts button will be disabled).
# TIKTOK_SCOPES=user.info.basic,video.list

# ── Clipper Studio ─────────────────────────────────────────────
# Postgres (Railway → add Postgres → copy DATABASE_URL). Migrations run automatically on web `npm start` (or `npm run migrate`).
DATABASE_URL=postgresql://postgres@localhost:5433/clipfarm
# Cloudflare R2 (S3-compatible). Leave blank in dev to store files on local disk (.data/storage).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clipfarm-media
# Local-disk storage root when R2 isn't configured (web + worker must share it).
LOCAL_STORAGE_DIR=.data/storage
# Word-level captions (Whisper). Without it, "Auto captions" is disabled.
OPENAI_API_KEY=
# Worker tuning
WORKER_CONCURRENCY=1
# yt-dlp self-updates on worker boot and daily (Twitch breaks it often). Set 0 to disable.
YTDLP_AUTO_UPDATE=1
# VOD highlight analysis reads chat replay from Twitch's web GQL endpoint (no Helix equivalent).
# Override only if Twitch rotates these; if chat fails, analysis still runs on clips + audio.
# TWITCH_GQL_CLIENT_ID=
# TWITCH_GQL_COMMENTS_HASH=
# Max length a clipper can pull from a VOD in one import (seconds)
MAX_IMPORT_SECONDS=900
# Twitch login the demo creator account maps to (dev only, when Twitch OAuth isn't configured)
DEMO_CREATOR_TWITCH=dlou
