# ClipFarm media worker — deploy as a second Railway service from this repo.
# Railway: set RAILWAY_DOCKERFILE_PATH=Dockerfile.worker on the worker service.
FROM node:22-bookworm-slim

# yt-dlp as the standalone release binary (not pip) so the worker can self-update with `yt-dlp -U`.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg python3 fonts-noto-color-emoji ca-certificates curl \
    && curl -fsSL https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp \
    && chmod a+rx /usr/local/bin/yt-dlp \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY . .

ENV NODE_ENV=production
CMD ["npm", "run", "worker"]
