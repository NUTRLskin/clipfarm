# ClipFarm media worker — deploy as a second Railway service from this repo.
# Railway: set RAILWAY_DOCKERFILE_PATH=Dockerfile.worker on the worker service.
FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg python3 python3-pip fonts-noto-color-emoji ca-certificates curl \
    && pip3 install --no-cache-dir --break-system-packages yt-dlp \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY . .

ENV NODE_ENV=production
CMD ["npm", "run", "worker"]
